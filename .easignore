# EAS archives the npm-workspace root. Keep only what the iOS build needs.
.git/
.claude/
node_modules/
**/node_modules/
*.zip
services/
apps/clinician-web/
docs/
logo/
ios/Pods/
ios/build/
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/.expo/
apps/mobile/dist/
# Never upload local notes, server details or design files from the repo root.
/server.md
/suggesiton.md
/posturepulse-technical-reference.md
/*.pdf
/*.png
/*.html
# Large local-only folders and files at the repo root that no build needs. Anchored with a
# leading slash so they cannot match app folders such as apps/mobile/assets/models.
/output/
/tmp/
/beaive-vitals-report/
/posturepulse-report-template-build/
/anuclaw/
/dataset/
/models/
/*.pdf
/*.zip
