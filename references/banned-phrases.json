{
  "version": "banned-phrases/v1",
  "description": "Case-insensitive regular expressions that must never appear in generated report text, templates or product copy (CLAUDE.md rule 1, docs/claims-and-scope.md, ADR-015). Condition names, normal/abnormal, risk, score, grades and interpretive verbs are the reviewing clinician's to write in the Clinician's assessment, never the system's. Some patterns are written with a character class or group so that this file itself does not trip scripts/lint-claims.sh.",
  "patterns": [
    "\\bnormal(ly)?\\b",
    "\\babnormal",
    "\\brisks?\\b",
    "\\brisky\\b",
    "\\bscor(e|es|ed|ing)\\b",
    "\\boptimal",
    "\\bexcellent",
    "\\bperfect",
    "\\btextbook",
    "\\bpoor posture",
    "\\bbad posture",
    "\\bgood posture",
    "\\bcorrect posture",
    "\\bideal posture",
    "\\bindicat(e|es|ed|ing|ive)\\b",
    "\\bsuggests? (a|an)\\b",
    "diagno(s)",
    "\\bhealthy\\b",
    "\\bunhealthy\\b",
    "\\bgrade[sd]?\\b",
    "\\bsyndrome",
    "\\bdisorder",
    "\\bdeformit",
    "\\bdysfunction",
    "\\bpatholog",
    "\\bimbalance",
    "\\bscoliosis",
    "\\bscoliotic",
    "\\bhyperkyphosis",
    "\\bhyperlordosis",
    "\\bkyphotic",
    "\\blordotic",
    "forward head posture",
    "rounded shoulders?",
    "sway ?back",
    "flat ?back",
    "military posture",
    "text neck",
    "dowager",
    "genu (valgum|varum|recurvatum)",
    "knock[- ]?knee",
    "bow[- ]?leg",
    "pelvic obliquity",
    "leg length discrepancy",
    "upper crossed",
    "lower crossed",
    "winged scapula",
    "\\bflat ?feet\\b",
    "pes (planus|cavus)",
    "over-?pronat"
  ]
}
