+import { describe, it, expect } from 'vitest';
+import { computePosition, fmt } from './format';
+import { findBannedPhrase } from './banned';
+import { renderPostureTemplate } from './template-provider';
+import { checkPostureConsistency } from './consistency-guard';
+import { explainPostureRow } from './explanation-service';
+import { validateExplainRequest, handleExplainRequest } from './api';
+import type { PostureProvider, PostureVerdict } from './types';
+
+const base: PostureVerdict = {
+  rowId: 'r1',
+  metricKey: 'static.shoulder_line_tilt',
+  label: 'Shoulder-line tilt',
+  tier: 'proxy',
+  unit: 'deg',
+  side: null,
+  position: 'within',
+  estimate: { value: 1.2, uncertainty: 0.6 },
+  reference: { kind: 'geometric', label: '0-5 deg', min: 0, max: 5, status: 'draft' },
+};
+const row = (over: Partial<PostureVerdict>): PostureVerdict => ({ ...base, ...over });
+
+const CASES: Array<[string, PostureVerdict]> = [
+  ['within', base],
+  ['above', row({ position: 'above', estimate: { value: 9.3, uncertainty: 1.1 } })],
+  ['below', row({ position: 'below', estimate: { value: -4.4, uncertainty: 0.5 } })],
+  ['indeterminate', row({ position: 'indeterminate', estimate: { value: 5.2, uncertainty: 1.5 } })],
+  ['no_reference', row({ position: 'no_reference', reference: null })],
+  ['estimate tier', row({ tier: 'estimate', side: 'left', metricKey: 'static.knee_extension', label: 'Knee extension' })],
+  ['not_applicable', row({ position: 'not_applicable', estimate: null, unsupportedReasons: ['out_of_frame', 'subject_moving'] })],
+];
+
+describe('computePosition (shared rule)', () => {
+  it('within only when the whole interval is inside the range', () => {
+    expect(computePosition({ value: 2, uncertainty: 1 }, { min: 0, max: 5 })).toBe('within');
+  });
+  it('below / above only when the whole interval is outside', () => {
+    expect(computePosition({ value: 9, uncertainty: 1 }, { min: 0, max: 5 })).toBe('above');
+    expect(computePosition({ value: -3, uncertainty: 1 }, { min: 0, max: 5 })).toBe('below');
+  });
+  it('indeterminate when the interval overlaps a bound', () => {
+    expect(computePosition({ value: 5.5, uncertainty: 1 }, { min: 0, max: 5 })).toBe('indeterminate');
+    expect(computePosition({ value: 0.2, uncertainty: 1 }, { min: 0, max: 5 })).toBe('indeterminate');
+  });
+  it('a single-value reference is indeterminate when the interval contains it', () => {
+    expect(computePosition({ value: 0.4, uncertainty: 1 }, { min: 0, max: 0 })).toBe('indeterminate');
+    expect(computePosition({ value: 3, uncertainty: 1 }, { min: 0, max: 0 })).toBe('above');
+  });
+  it('no_reference without a reference, not_applicable without an estimate', () => {
+    expect(computePosition({ value: 1, uncertainty: 1 }, null)).toBe('no_reference');
+    expect(computePosition(null, { min: 0, max: 5 })).toBe('not_applicable');
+  });
+  it('formats numbers without trailing zeros', () => {
+    expect([fmt(4), fmt(80.74), fmt(2.05)]).toEqual(['4', '80.7', '2.1']);
+  });
+});
+
+describe('banned phrase list', () => {
+  it.each([
+    'Possible scoliosis', 'a normal range', 'excellent alignment', 'poor posture', 'risk of injury',
+    'caused by desk work', 'posture score 80', 'typical for office workers', 'valgus deformity',
+  ])('flags %s', (t) => expect(findBannedPhrase(t)).not.toBeNull());
+  it('lets plain measurement wording through', () => {
+    expect(findBannedPhrase('Shoulder-line tilt: 1.2° ± 0.6°; within the 0-5 deg reference.')).toBeNull();
+  });
+});
+
+describe('deterministic template is faithful for every position', () => {
+  it.each(CASES)('%s passes the consistency guard and the banned list', (_n, verdict) => {
+    const draft = renderPostureTemplate(verdict);
+    expect(checkPostureConsistency(verdict, draft)).toEqual({ consistent: true, violations: [] });
+    expect(findBannedPhrase(draft.text)).toBeNull();
+  });
+
+  it('states uncertainty with the value and names the side', () => {
+    const t = renderPostureTemplate(CASES[5][1]).text;
+    expect(t).toContain('1.2');
+    expect(t).toContain('0.6');
+    expect(t.toLowerCase()).toContain('left');
+  });
+
+  it('not-applicable text contains no numbers and lists the reasons in plain words', () => {
+    const t = renderPostureTemplate(CASES[6][1]).text;
+    expect(t).not.toMatch(/\d/);
+    expect(t.toLowerCase()).toContain('not measured');
+    expect(t.toLowerCase()).toContain('cut off');
+  });
+});
+
+describe('consistency guard rejects unfaithful narratives', () => {
+  const draftFor = (verdict: PostureVerdict, text: string, over = {}) => {
+    const d = renderPostureTemplate(verdict);
+    return { text, assertions: { ...d.assertions, ...over } };
+  };
+  it('wrong position assertion', () => {
+    const d = draftFor(base, 'Shoulder-line tilt: 1.2° ± 0.6°; within the 0-5 deg reference.', { position: 'above' });
+    expect(checkPostureConsistency(base, d).consistent).toBe(false);
+  });
+  it('invented number', () => {
+    const d = draftFor(base, 'Shoulder-line tilt: 1.2° ± 0.6°; within the 0-5 deg reference; about 12° from level.');
+    const r = checkPostureConsistency(base, d);
+    expect(r.consistent).toBe(false);
+    expect(r.violations.join(' ')).toMatch(/12/);
+  });
+  it('flipped direction in prose', () => {
+    const v = row({ position: 'above', estimate: { value: 9.3, uncertainty: 1.1 } });
+    const d = draftFor(v, 'Shoulder-line tilt: 9.3° ± 1.1°; below the 0-5 deg reference by about 4.3°.');
+    expect(checkPostureConsistency(v, d).consistent).toBe(false);
+  });
+  it('banned phrase in prose', () => {
+    const d = draftFor(base, 'Shoulder-line tilt: 1.2° ± 0.6°; within the 0-5 deg reference, which is normal.');
+    expect(checkPostureConsistency(base, d).consistent).toBe(false);
+  });
+  it('a reference claim when none is set', () => {
+    const v = row({ position: 'no_reference', reference: null });
+    const d = draftFor(v, 'Shoulder-line tilt: 1.2° ± 0.6°; within the usual reference.');
+    expect(checkPostureConsistency(v, d).consistent).toBe(false);
+  });
+  it('a value on a not-measured row', () => {
+    const v = CASES[6][1];
+    const d = draftFor(v, 'Shoulder-line tilt: not measured; about 3° from level.');
+    expect(checkPostureConsistency(v, d).consistent).toBe(false);
+  });
+  it('a banned phrase supplied through the label escalates the whole row', () => {
+    const v = row({ label: 'Scoliosis angle' });
+    expect(checkPostureConsistency(v, renderPostureTemplate(v)).consistent).toBe(false);
+  });
+});
+
+describe('explainPostureRow', () => {
+  it('uses the deterministic template by default', async () => {
+    const r = await explainPostureRow(base);
+    expect(r.status).toBe('template');
+    expect(r.text).toContain('within the 0-5 deg reference');
+    expect(r.escalate).toBe(false);
+  });
+
+  it('accepts an injected narrator that passes the guard', async () => {
+    const good: PostureProvider = {
+      name: 'fake-llm',
+      generate: ({ verdict }) => renderPostureTemplate(verdict),
+    };
+    const r = await explainPostureRow(base, { provider: good });
+    expect(r.status).toBe('llm');
+    expect(r.source).toBe('fake-llm');
+  });
+
+  it('discards a contradicting narrator output, retries, then escalates with no text', async () => {
+    let calls = 0;
+    const bad: PostureProvider = {
+      name: 'bad-llm',
+      generate: ({ verdict }) => {
+        calls++;
+        return { ...renderPostureTemplate(verdict), text: 'Looks perfect, textbook alignment.' };
+      },
+    };
+    const r = await explainPostureRow(base, { provider: bad, maxAttempts: 2 });
+    expect(calls).toBe(2);
+    expect(r.status).toBe('escalated');
+    expect(r.text).toBeNull();
+    expect(r.escalate).toBe(true);
+  });
+
+  it('falls back to the template (flagged) when the provider throws', async () => {
+    const down: PostureProvider = { name: 'down', generate: () => { throw new Error('unavailable'); } };
+    const r = await explainPostureRow(base, { provider: down });
+    expect(r.status).toBe('template_fallback');
+    expect(r.flagged).toBe(true);
+    expect(r.text).not.toBeNull();
+  });
+});
+
+describe('request validation and handler', () => {
+  const ok = { verdicts: [base] };
+
+  it('accepts a well-formed request', () => {
+    expect(validateExplainRequest(ok)).toEqual({ ok: true, verdicts: [base] });
+  });
+  it('rejects unknown fields so identifiers cannot ride along', () => {
+    const r = validateExplainRequest({ verdicts: [{ ...base, patientName: 'x' }] });
+    expect(r.ok).toBe(false);
+    const r2 = validateExplainRequest({ verdicts: [base], sessionId: 's1' });
+    expect(r2.ok).toBe(false);
+  });
+  it('rejects empty, oversized and malformed bodies', () => {
+    expect(validateExplainRequest({ verdicts: [] }).ok).toBe(false);
+    expect(validateExplainRequest({ verdicts: Array(201).fill(base) }).ok).toBe(false);
+    expect(validateExplainRequest(null).ok).toBe(false);
+    expect(validateExplainRequest({ verdicts: [{ ...base, position: 'great' }] }).ok).toBe(false);
+  });
+  it('rejects duplicate row ids', () => {
+    expect(validateExplainRequest({ verdicts: [base, base] }).ok).toBe(false);
+  });
+  it('rejects a position that disagrees with the numbers (never reclassify)', async () => {
+    const r = await handleExplainRequest({ verdicts: [row({ position: 'within', estimate: { value: 9.3, uncertainty: 1.1 } })] });
+    expect(r.status).toBe(422);
+  });
+  it('explains every row and reports the explanation version', async () => {
+    const r = await handleExplainRequest({ verdicts: CASES.map(([, v], i) => ({ ...v, rowId: `r${i}` })) });
+    expect(r.status).toBe(200);
+    const body = r.body as { explanationVersion: string; results: Array<{ rowId: string; text: string | null }> };
+    expect(body.explanationVersion).toMatch(/^posture-explain\//);
+    expect(body.results).toHaveLength(CASES.length);
+    expect(body.results.every((x) => typeof x.text === 'string')).toBe(true);
+  });
+});
