+/**
+ * Model-backed narrator for POST /v1/posture/explain, via OpenRouter. Lives outside
+ * src/cds so the decision core stays model-free. The model supplies ONLY the sentence;
+ * the structured assertions come from the verdict itself, and the sentence is then
+ * checked by the consistency guard (banned phrases, numbers the row does not own,
+ * direction vs. position). A failure here never changes a number or a classification.
+ * The API key is read from the environment by the caller and never logged.
+ */
+import { renderPostureTemplate } from '../cds/posture-explanation/template-provider';
+import type { PostureProvider } from '../cds/posture-explanation/types';
+
+export interface OpenRouterPostureOptions {
+  apiKey: string;
+  model: string;
+  baseUrl?: string;
+  timeoutMs?: number;
+  fetchImpl?: typeof fetch;
+}
+
+export function createOpenRouterPostureProvider(opts: OpenRouterPostureOptions): PostureProvider {
+  const doFetch = opts.fetchImpl ?? fetch;
+  const url = `${opts.baseUrl ?? 'https://openrouter.ai/api/v1'}/chat/completions`;
+  return {
+    name: `openrouter:${opts.model}`,
+    async generate({ prompt, verdict }) {
+      const res = await doFetch(url, {
+        method: 'POST',
+        headers: {
+          Authorization: `Bearer ${opts.apiKey}`,
+          'Content-Type': 'application/json',
+          'X-Title': 'beAIve posture explain',
+        },
+        body: JSON.stringify({
+          model: opts.model,
+          temperature: 0,
+          max_tokens: 300,
+          response_format: { type: 'json_object' },
+          messages: [{ role: 'user', content: prompt }],
+        }),
+        signal: AbortSignal.timeout(opts.timeoutMs ?? 15000),
+      });
+      if (!res.ok) throw new Error(`openrouter HTTP ${res.status}`);
+      const body = (await res.json()) as { choices?: Array<{ message?: { content?: string } }> };
+      const content = body.choices?.[0]?.message?.content ?? '';
+      const start = content.indexOf('{');
+      const end = content.lastIndexOf('}');
+      let text: unknown;
+      try {
+        text = JSON.parse(content.slice(start, end + 1)).text;
+      } catch {
+        throw new Error('openrouter response was not JSON');
+      }
+      if (typeof text !== 'string' || !text.trim()) throw new Error('openrouter response had no text');
+      return { text: text.trim(), assertions: renderPostureTemplate(verdict).assertions };
+    },
+  };
+}
+
+/**
+ * Chosen by scripts/posture-model-bench.ts on synthetic rows through the real consistency
+ * guard (30/30 faithful sentences, ~1 s, about $0.035 per 1,000 rows). No medical-tuned model
+ * is listed on OpenRouter; for one-sentence measurement wording a medical model adds nothing
+ * and the guard, not the model, is what keeps the text safe.
+ */
+export const DEFAULT_POSTURE_MODEL = 'mistralai/mistral-small-3.2-24b-instruct';
+
+/** undefined means: use the deterministic template only (no key, or switched off). */
+export function postureProviderFromEnv(env: Record<string, string | undefined>): PostureProvider | undefined {
+  if (env.POSTURE_LLM_DISABLED === '1') return undefined;
+  const apiKey = (env.POSTURE_LLM_API_KEY ?? env.OPENROUTER_API_KEY ?? '').trim();
+  if (!apiKey) return undefined;
+  return createOpenRouterPostureProvider({ apiKey, model: (env.POSTURE_LLM_MODEL ?? '').trim() || DEFAULT_POSTURE_MODEL });
+}
