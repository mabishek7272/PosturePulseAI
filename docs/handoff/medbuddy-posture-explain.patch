index 0000000..42630f6
--- /dev/null
+++ b/ANUClaw/src/cds/posture-explanation/README.md
@@ -0,0 +1,19 @@
+# Posture-report explanations
+
+`POST /v1/posture/explain` (auth required, mounted in `src/api/server.ts`) turns each
+already-measured row of a beAIve posture report into one plain sentence.
+
+Request: `{ verdicts: PostureVerdict[] }` (1-200 rows; see `types.ts`). Measurements only -
+unknown fields (patient or session identifiers) are rejected with 400. A row whose
+`position` disagrees with its own value, uncertainty and reference is refused with 422;
+this layer never reclassifies.
+
+Response: `{ explanationVersion, results: PostureExplanation[] }`. `text` is `null` when a
+row is `escalated` - the caller must then use its own fixed sentence. The caller should
+also re-check every returned sentence against its own rules before showing it.
+
+Authority order is the same as `src/cds/explanation`: measurement and classification are
+decided upstream; this layer only describes; the consistency guard rejects any sentence
+with a banned phrase, a number the row does not own, or a direction that contradicts the
+position. No model is wired in: the deterministic template is the default narrator, and a
+`PostureProvider` can be injected (outside `src/cds`) later.
diff --git a/ANUClaw/src/cds/posture-explanation/api.ts b/ANUClaw/src/cds/posture-explanation/api.ts
new file mode 100644
index 0000000..632250c
--- /dev/null
+++ b/ANUClaw/src/cds/posture-explanation/api.ts
@@ -0,0 +1,79 @@
+/**
+ * Request validation and handler for POST /v1/posture/explain. Framework-agnostic so
+ * it is unit-tested without HTTP; src/api/routes/posture.ts is the thin Express adapter.
+ *
+ * The request is strict: unknown fields are rejected so patient or session identifiers
+ * cannot ride along, and a row whose position disagrees with its own numbers is refused
+ * (422) rather than silently reclassified.
+ */
+import { computePosition } from './format';
+import { explainPostureRow, ExplainOptions } from './explanation-service';
+import { EXPLANATION_VERSION, PostureVerdict } from './types';
+
+const POSITIONS = ['below', 'within', 'above', 'indeterminate', 'no_reference', 'not_applicable'];
+const TIERS = ['estimate', 'proxy', 'entered', 'annotated'];
+const UNITS = ['deg', 'cm', 'percent_stature', 's', 'count', 'per_min', 'percent', 'none'];
+const SIDES = ['left', 'right', 'bilateral', null];
+const ROW_KEYS = new Set(['rowId', 'metricKey', 'label', 'tier', 'unit', 'side', 'position', 'estimate', 'reference', 'unsupportedReasons']);
+const REF_KEYS = new Set(['kind', 'label', 'min', 'max', 'status']);
+export const MAX_ROWS = 200;
+
+const isObj = (x: unknown): x is Record<string, unknown> => typeof x === 'object' && x !== null && !Array.isArray(x);
+const isNum = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x);
+const isStr = (x: unknown, max = 200): x is string => typeof x === 'string' && x.length > 0 && x.length <= max;
+
+export type Validation = { ok: true; verdicts: PostureVerdict[] } | { ok: false; errors: string[] };
+
+export function validateExplainRequest(body: unknown): Validation {
+  const errors: string[] = [];
+  if (!isObj(body)) return { ok: false, errors: ['body must be an object'] };
+  for (const k of Object.keys(body)) if (k !== 'verdicts') errors.push(`unknown field '${k}'`);
+  const rows = body.verdicts;
+  if (!Array.isArray(rows) || rows.length === 0) errors.push('verdicts must be a non-empty array');
+  else if (rows.length > MAX_ROWS) errors.push(`at most ${MAX_ROWS} verdicts per request`);
+  if (errors.length || !Array.isArray(rows)) return { ok: false, errors };
+
+  const seen = new Set<string>();
+  rows.forEach((r, i) => {
+    const at = `verdicts[${i}]`;
+    if (!isObj(r)) { errors.push(`${at} must be an object`); return; }
+    for (const k of Object.keys(r)) if (!ROW_KEYS.has(k)) errors.push(`${at}: unknown field '${k}'`);
+    if (!isStr(r.rowId, 80)) errors.push(`${at}.rowId`); else if (seen.has(r.rowId)) errors.push(`${at}.rowId duplicate '${r.rowId}'`); else seen.add(r.rowId);
+    if (!isStr(r.metricKey, 120)) errors.push(`${at}.metricKey`);
+    if (!isStr(r.label, 120)) errors.push(`${at}.label`);
+    if (!TIERS.includes(r.tier as string)) errors.push(`${at}.tier`);
+    if (!UNITS.includes(r.unit as string)) errors.push(`${at}.unit`);
+    if (!SIDES.includes((r.side ?? null) as string | null)) errors.push(`${at}.side`);
+    if (!POSITIONS.includes(r.position as string)) errors.push(`${at}.position`);
+    if (r.estimate != null) {
+      const est = r.estimate;
+      if (!isObj(est) || !isNum(est.value) || !isNum(est.uncertainty) || est.uncertainty < 0) errors.push(`${at}.estimate`);
+      else for (const k of Object.keys(est)) if (k !== 'value' && k !== 'uncertainty') errors.push(`${at}.estimate: unknown field '${k}'`);
+    }
+    if (r.reference != null) {
+      const ref = r.reference;
+      if (!isObj(ref) || !isStr(ref.label, 60) || !isNum(ref.min) || !isNum(ref.max) || ref.min > ref.max
+        || !['geometric', 'literature'].includes(ref.kind as string) || !['draft', 'approved'].includes(ref.status as string)) errors.push(`${at}.reference`);
+      else for (const k of Object.keys(ref)) if (!REF_KEYS.has(k)) errors.push(`${at}.reference: unknown field '${k}'`);
+    }
+    if (r.unsupportedReasons != null && !(Array.isArray(r.unsupportedReasons) && r.unsupportedReasons.every((x) => isStr(x, 60)))) errors.push(`${at}.unsupportedReasons`);
+  });
+  return errors.length ? { ok: false, errors } : { ok: true, verdicts: rows as PostureVerdict[] };
+}
+
+export interface HandlerResult { status: number; body: unknown }
+
+export async function handleExplainRequest(body: unknown, options: ExplainOptions = {}): Promise<HandlerResult> {
+  const v = validateExplainRequest(body);
+  if (!v.ok) return { status: 400, body: { error: 'Invalid request', errors: v.errors } };
+
+  const mismatches: string[] = [];
+  for (const row of v.verdicts) {
+    const expected = computePosition(row.estimate ?? null, row.reference ?? null);
+    if (expected !== row.position) mismatches.push(`${row.rowId}: position '${row.position}' disagrees with its numbers ('${expected}')`);
+  }
+  if (mismatches.length) return { status: 422, body: { error: 'Position disagrees with the measurement', errors: mismatches } };
+
+  const results = await Promise.all(v.verdicts.map((row) => explainPostureRow(row, options)));
+  return { status: 200, body: { explanationVersion: EXPLANATION_VERSION, results } };
+}
diff --git a/ANUClaw/src/cds/posture-explanation/banned.ts b/ANUClaw/src/cds/posture-explanation/banned.ts
new file mode 100644
index 0000000..7c96581
--- /dev/null
+++ b/ANUClaw/src/cds/posture-explanation/banned.ts
@@ -0,0 +1,24 @@
+/**
+ * Wording that must never appear in a posture-report sentence: condition names,
+ * grades, risk and causation claims, scores. Kept in step with the beAIve
+ * repository's references/banned-phrases.json (that file is the source of truth for
+ * the product; this copy is MedBuddy's own last line of defence).
+ */
+const PATTERNS: RegExp[] = [
+  /\bdiagnos\w*/i,
+  /\b(scolio\w*|kyphos\w*|lordos\w*|valgus|varus|valgum|varum|recurvatum|trendelenburg|spondyl\w*|arthrit\w*|osteo\w*)\b/i,
+  /\b(syndrome|deformity|dysfunction|pathology|pathological|disorder|disease|condition|impairment|weakness|tightness)\b/i,
+  /\b(normal|abnormal|healthy|unhealthy|optimal|ideal|excellent|perfect|textbook|great|poor|bad|good)\b/i,
+  /\b(risk|injur\w*|prevent\w*|treat\w*|cure\w*|therap\w*|predict\w*)\b/i,
+  /\b(caused by|due to|because of|typical for|typical of|common in|indicates|indicative|suggests|likely|probably|linked to|sign of)\b/i,
+  /\b(score\w*|rating|grade\w*|rank\w*)\b/i,
+  /\b(should|must|need to|recommend\w*|advise\w*)\b/i,
+];
+
+export function findBannedPhrase(text: string): string | null {
+  for (const re of PATTERNS) {
+    const m = re.exec(text);
+    if (m) return m[0];
+  }
+  return null;
+}
diff --git a/ANUClaw/src/cds/posture-explanation/consistency-guard.ts b/ANUClaw/src/cds/posture-explanation/consistency-guard.ts
new file mode 100644
index 0000000..095de90
--- /dev/null
+++ b/ANUClaw/src/cds/posture-explanation/consistency-guard.ts
@@ -0,0 +1,87 @@
+/**
+ * Consistency guard for posture rows. Layer A: the narrator's structured assertions
+ * must equal the verdict. Layer B: the prose must contain no banned phrase, no number
+ * the row does not own, and no claim that contradicts the position. Pure and
+ * deterministic; the verdict is never changed to match the prose.
+ */
+import { findBannedPhrase } from './banned';
+import { deviationFrom, round1 } from './format';
+import type { PostureConsistency, PostureDraft, PostureVerdict } from './types';
+
+const NUMBER_RE = /\d+(?:\.\d+)?/g;
+const near = (a: number, b: number) => Math.abs(a - b) < 0.051;
+
+function numbersIn(text: string): number[] {
+  return (text.match(NUMBER_RE) ?? []).map(Number);
+}
+
+export function checkPostureConsistency(v: PostureVerdict, draft: PostureDraft): PostureConsistency {
+  const out: string[] = [];
+  const a = draft.assertions;
+  const text = draft.text;
+  const lc = text.toLowerCase();
+  const e = v.estimate ?? null;
+  const ref = v.reference ?? null;
+
+  // The caller-supplied label is part of the sentence, so a banned label fails the row.
+  const banned = findBannedPhrase(text);
+  if (banned) out.push(`banned phrase in text: '${banned}'`);
+
+  // ── Layer A ───────────────────────────────────────────────────────────────
+  if (a.rowId !== v.rowId) out.push(`rowId mismatch: '${a.rowId}'`);
+  if (a.metricKey !== v.metricKey) out.push(`metricKey mismatch: '${a.metricKey}'`);
+  if (a.position !== v.position) out.push(`position mismatch: narrative asserts '${a.position}' but row is '${v.position}'`);
+  if ((a.side ?? null) !== (v.side ?? null)) out.push(`side mismatch: '${a.side}' vs '${v.side}'`);
+  const expectedValue = e ? round1(e.value) : undefined;
+  if (a.value !== expectedValue) out.push(`value mismatch: '${a.value}' vs '${expectedValue}'`);
+  const expectedDev = deviationFrom(v.position, e, ref);
+  if (a.deviation !== expectedDev) out.push(`deviation mismatch: '${a.deviation}' vs '${expectedDev}'`);
+
+  // ── Layer B ───────────────────────────────────────────────────────────────
+  const allowed: number[] = [];
+  if (e) allowed.push(e.value, e.uncertainty);
+  if (expectedDev !== undefined) allowed.push(expectedDev);
+  if (ref) allowed.push(ref.min, ref.max, ...numbersIn(ref.label));
+  allowed.push(...numbersIn(v.label));
+  for (const n of numbersIn(text)) {
+    if (!allowed.some((x) => near(n, x) || near(n, Math.abs(x)))) out.push(`number not in the row: ${n}`);
+  }
+
+  if (!lc.includes(v.label.toLowerCase())) out.push('text does not name the measurement');
+
+  const mentionsWithin = /\bwithin\b/.test(lc);
+  const mentionsAbove = /\babove\b/.test(lc);
+  const mentionsBelow = /\bbelow\b/.test(lc);
+  const mentionsOverlap = /\boverlaps?\b/.test(lc);
+  const mentionsNotMeasured = /\bnot measured\b/.test(lc);
+
+  switch (v.position) {
+    case 'within':
+      if (!mentionsWithin) out.push("'within' row does not say so");
+      if (mentionsAbove || mentionsBelow || mentionsOverlap) out.push("'within' row contains a contradicting direction");
+      break;
+    case 'above':
+      if (!mentionsAbove) out.push("'above' row does not say so");
+      if (mentionsBelow || mentionsWithin || mentionsOverlap) out.push("'above' row contains a contradicting direction");
+      break;
+    case 'below':
+      if (!mentionsBelow) out.push("'below' row does not say so");
+      if (mentionsAbove || mentionsWithin || mentionsOverlap) out.push("'below' row contains a contradicting direction");
+      break;
+    case 'indeterminate':
+      if (!mentionsOverlap) out.push("'indeterminate' row does not say the uncertainty overlaps");
+      if (mentionsAbove || mentionsBelow || mentionsWithin) out.push("'indeterminate' row contains a definite direction");
+      break;
+    case 'no_reference':
+      if (mentionsAbove || mentionsBelow || mentionsWithin || mentionsOverlap) out.push("'no_reference' row compares with a reference");
+      if (!/\bno reference\b/.test(lc)) out.push("'no_reference' row does not say no reference is set");
+      break;
+    case 'not_applicable':
+    default:
+      if (!mentionsNotMeasured) out.push("'not_applicable' row does not say 'not measured'");
+      if (/\d/.test(text.replace(v.label, ''))) out.push("'not_applicable' row contains a number");
+      break;
+  }
+
+  return { consistent: out.length === 0, violations: out };
+}
diff --git a/ANUClaw/src/cds/posture-explanation/explanation-service.ts b/ANUClaw/src/cds/posture-explanation/explanation-service.ts
new file mode 100644
index 0000000..fe9bd0e
--- /dev/null
+++ b/ANUClaw/src/cds/posture-explanation/explanation-service.ts
@@ -0,0 +1,85 @@
+/**
+ * Explanation service for one posture row: constrained generation + consistency guard.
+ *   1. Ask the narrator (deterministic template by default, or an injected model).
+ *   2. Verify against the verdict; on contradiction discard and retry up to N times.
+ *   3. After N failures, ESCALATE with no text - the caller uses its own fixed sentence.
+ *   4. If the provider throws, fall back to the template (flagged).
+ * The row's numbers and position are never changed to match a narrative.
+ */
+import { checkPostureConsistency } from './consistency-guard';
+import { buildPosturePrompt } from './prompt';
+import { deterministicPostureProvider, renderPostureTemplate } from './template-provider';
+import type { PostureConsistency, PostureExplanation, PostureProvider, PostureVerdict } from './types';
+
+export interface ExplainOptions {
+  provider?: PostureProvider;
+  maxAttempts?: number;
+}
+
+export async function explainPostureRow(
+  verdict: PostureVerdict,
+  options: ExplainOptions = {},
+): Promise<PostureExplanation> {
+  const provider = options.provider ?? deterministicPostureProvider;
+  const isModel = provider !== deterministicPostureProvider;
+  const maxAttempts = Math.max(1, options.maxAttempts ?? 3);
+  const prompt = buildPosturePrompt(verdict);
+  const audit: PostureExplanation['audit'] = [];
+  let last: PostureConsistency = { consistent: false, violations: [] };
+
+  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+    let draft;
+    try {
+      draft = await provider.generate({ prompt, verdict, attempt });
+    } catch (err) {
+      audit.push({ type: 'provider_error', attempt, detail: err instanceof Error ? err.message : String(err) });
+      return fallback(verdict, attempt, audit);
+    }
+    audit.push({ type: 'generated', attempt, detail: provider.name });
+    last = checkPostureConsistency(verdict, draft);
+    audit.push({ type: last.consistent ? 'consistent' : 'inconsistent', attempt, detail: last.violations.join('; ') || undefined });
+    if (last.consistent) {
+      return {
+        rowId: verdict.rowId,
+        status: isModel ? 'llm' : 'template',
+        text: draft.text,
+        assertions: draft.assertions,
+        source: provider.name,
+        attempts: attempt,
+        escalate: false,
+        flagged: false,
+        consistency: last,
+        audit,
+      };
+    }
+  }
+
+  return {
+    rowId: verdict.rowId,
+    status: 'escalated',
+    text: null,
+    assertions: null,
+    source: provider.name,
+    attempts: maxAttempts,
+    escalate: true,
+    flagged: true,
+    consistency: last,
+    audit,
+  };
+}
+
+function fallback(verdict: PostureVerdict, attempt: number, audit: PostureExplanation['audit']): PostureExplanation {
+  const draft = renderPostureTemplate(verdict);
+  const consistency = checkPostureConsistency(verdict, draft);
+  if (!consistency.consistent) {
+    // e.g. a banned caller-supplied label: no safe text exists for this row.
+    return {
+      rowId: verdict.rowId, status: 'escalated', text: null, assertions: null, source: deterministicPostureProvider.name,
+      attempts: attempt, escalate: true, flagged: true, consistency, audit,
+    };
+  }
+  return {
+    rowId: verdict.rowId, status: 'template_fallback', text: draft.text, assertions: draft.assertions,
+    source: deterministicPostureProvider.name, attempts: attempt, escalate: false, flagged: true, consistency, audit,
+  };
+}
diff --git a/ANUClaw/src/cds/posture-explanation/format.ts b/ANUClaw/src/cds/posture-explanation/format.ts
new file mode 100644
index 0000000..771bdff
--- /dev/null
+++ b/ANUClaw/src/cds/posture-explanation/format.ts
@@ -0,0 +1,73 @@
+import type { PosturePosition, PostureUnit } from './types';
+
+/** Round to 0.1 and drop a trailing ".0" so 4.0 reads "4". */
+export function fmt(n: number): string {
+  return String(Number((Math.round(n * 10) / 10).toFixed(1)));
+}
+
+export function round1(n: number): number {
+  return Math.round(n * 10) / 10;
+}
+
+export function unitText(unit: PostureUnit): string {
+  switch (unit) {
+    case 'deg': return '°';
+    case 'cm': return ' cm';
+    case 'percent_stature': return '% of stature';
+    case 's': return ' s';
+    case 'per_min': return ' /min';
+    case 'percent': return '%';
+    default: return '';
+  }
+}
+
+/**
+ * The one position rule, identical to the beAIve report builder: the interval
+ * value +/- uncertainty is compared with the reference range. below/above only when the whole
+ * interval is outside; within only when it is entirely inside; otherwise indeterminate.
+ */
+export function computePosition(
+  estimate: { value: number; uncertainty: number } | null | undefined,
+  reference: { min: number; max: number } | null | undefined,
+): PosturePosition {
+  if (!estimate) return 'not_applicable';
+  if (!reference) return 'no_reference';
+  const lo = estimate.value - estimate.uncertainty;
+  const hi = estimate.value + estimate.uncertainty;
+  if (hi < reference.min) return 'below';
+  if (lo > reference.max) return 'above';
+  if (lo >= reference.min && hi <= reference.max) return 'within';
+  return 'indeterminate';
+}
+
+/** Distance of the point estimate from the nearest reference bound, in the row's unit. */
+export function deviationFrom(
+  position: PosturePosition,
+  estimate: { value: number } | null | undefined,
+  reference: { min: number; max: number } | null | undefined,
+): number | undefined {
+  if (!estimate || !reference) return undefined;
+  if (position === 'above') return round1(estimate.value - reference.max);
+  if (position === 'below') return round1(reference.min - estimate.value);
+  return undefined;
+}
+
+const REASONS: Record<string, string> = {
+  insufficient_landmarks: 'too few body points could be found',
+  insufficient_scale: 'no reliable scale was available',
+  identity_uncertain: 'the person could not be tracked reliably',
+  anchor_drift: 'the camera position drifted',
+  low_confidence: 'the body points were not clear enough',
+  occlusion: 'part of the body was hidden',
+  wrong_view: 'the body was not facing the required way',
+  out_of_frame: 'part of the body was cut off by the edge of the picture',
+  camera_not_level: 'the phone was tilted too much',
+  insufficient_frame_rate: 'the video frame rate was too low',
+  insufficient_frames: 'too few usable frames were recorded',
+  subject_moving: 'the person was not still enough',
+};
+
+export function reasonsText(codes: string[] | undefined): string {
+  const list = (codes ?? []).map((c) => REASONS[c]).filter(Boolean);
+  return list.length ? list.join('; ') : 'the recording did not meet the quality needed';
+}
