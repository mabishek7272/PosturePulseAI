+/**
+ * Deterministic narrator: builds one sentence from the row's own numbers, so it is
+ * faithful by construction and always passes the consistency guard. It is the default
+ * narrator, the fallback when an injected model is unavailable, and uses no model.
+ * Wording describes the measurement against the stated reference - never a grade,
+ * a cause, a condition or advice.
+ */
+import { deviationFrom, fmt, reasonsText, round1, unitText } from './format';
+import type { PostureDraft, PostureProvider, PostureVerdict } from './types';
+
+function sideText(side: PostureVerdict['side']): string {
+  return side === 'left' ? ' (left)' : side === 'right' ? ' (right)' : '';
+}
+
+export function renderPostureTemplate(v: PostureVerdict): PostureDraft {
+  const head = `${v.label}${sideText(v.side)}`;
+  const u = unitText(v.unit);
+  const e = v.estimate ?? null;
+  const ref = v.reference ?? null;
+  const proxy = v.tier === 'proxy' ? ' This is a proxy measure.' : '';
+  const measured = e ? `${head}: ${fmt(e.value)}${u} ± ${fmt(e.uncertainty)}${u}` : head;
+  let text: string;
+
+  switch (v.position) {
+    case 'within':
+      text = `${measured}; within the ${ref?.label} reference.${proxy}`;
+      break;
+    case 'above':
+    case 'below': {
+      const d = deviationFrom(v.position, e, ref);
+      text = `${measured}; ${v.position} the ${ref?.label} reference by about ${fmt(d ?? 0)}${u}.${proxy}`;
+      break;
+    }
+    case 'indeterminate':
+      text = `${measured}; the uncertainty overlaps the ${ref?.label} reference.${proxy}`;
+      break;
+    case 'no_reference':
+      text = `${measured}. No reference value is set for this measurement.${proxy}`;
+      break;
+    case 'not_applicable':
+    default:
+      text = `${head}: not measured - ${reasonsText(v.unsupportedReasons)}.`;
+      break;
+  }
+
+  return {
+    text,
+    assertions: {
+      rowId: v.rowId,
+      metricKey: v.metricKey,
+      position: v.position,
+      side: v.side,
+      value: e ? round1(e.value) : undefined,
+      deviation: deviationFrom(v.position, e, ref),
+    },
+  };
+}
+
+export const deterministicPostureProvider: PostureProvider = {
+  name: 'deterministic-template',
+  generate: ({ verdict }) => renderPostureTemplate(verdict),
+};
