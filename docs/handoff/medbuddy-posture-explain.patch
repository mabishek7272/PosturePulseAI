+/**
+ * POST /v1/posture/explain - one plain sentence per measured posture row.
+ *
+ * Auth (X-API-Key or Bearer) is applied where the router is mounted (server.ts), the
+ * same as /v1/ruo. The body carries measurements only: no patient or session
+ * identifiers (unknown fields are rejected). The sentence can only describe the row;
+ * it never changes a number or a classification (see src/cds/posture-explanation).
+ */
+import { Router, Request, Response } from 'express';
+import { handleExplainRequest } from '../../cds/posture-explanation';
+import { logger } from '../../logger';
+
+export function createPostureRouter(): Router {
+  const router = Router();
+
+  router.post('/explain', async (req: Request, res: Response) => {
+    try {
+      const { status, body } = await handleExplainRequest(req.body);
+      res.status(status).json(body);
+    } catch (err) {
+      // Fail closed: no sentence is better than a guessed one; the caller has its own fixed text.
+      logger.error(`posture explain failed: ${err instanceof Error ? err.message : String(err)}`);
+      res.status(500).json({ error: 'Explanation failed' });
+    }
+  });
+
+  return router;
+}
