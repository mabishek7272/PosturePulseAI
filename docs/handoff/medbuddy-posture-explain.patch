+/**
+ * Prompt for an injected model narrator. The deterministic template ignores it.
+ * Not wired to any model yet; see index.ts.
+ */
+import { deviationFrom, round1 } from './format';
+import type { PostureVerdict } from './types';
+
+export function buildPosturePrompt(v: PostureVerdict): string {
+  const facts = {
+    rowId: v.rowId,
+    metricKey: v.metricKey,
+    label: v.label,
+    tier: v.tier,
+    unit: v.unit,
+    side: v.side,
+    position: v.position,
+    value: v.estimate ? round1(v.estimate.value) : null,
+    uncertainty: v.estimate ? round1(v.estimate.uncertainty) : null,
+    reference: v.reference ? v.reference.label : null,
+    deviation: deviationFrom(v.position, v.estimate, v.reference) ?? null,
+    unsupportedReasons: v.unsupportedReasons ?? [],
+  };
+  return [
+    'You write ONE short sentence describing a camera-based body measurement.',
+    'You describe; you never grade, diagnose, explain causes, predict, or advise.',
+    'Use only the numbers below. Do not add any other number. Do not name any condition.',
+    'Say whether the value is within, above or below the reference, or that its uncertainty overlaps it,',
+    'or that no reference is set, or that it was not measured - exactly as the position states.',
+    'Return STRICT JSON: { "text": string, "assertions": { "rowId", "metricKey", "position", "side", "value", "deviation" } }.',
+    '',
+    'ROW FACTS (authoritative - do not alter):',
+    JSON.stringify(facts, null, 2),
+  ].join('\n');
+}
