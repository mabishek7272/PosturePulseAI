+import { describe, it, expect } from 'vitest';
+import { createOpenRouterPostureProvider } from './posture-llm';
+import { explainPostureRow } from '../cds/posture-explanation';
+import type { PostureVerdict } from '../cds/posture-explanation';
+
+const verdict: PostureVerdict = {
+  rowId: 'r1', metricKey: 'static.shoulder_line_tilt', label: 'Shoulder-line tilt', tier: 'proxy', unit: 'deg', side: null,
+  position: 'above', estimate: { value: 9.3, uncertainty: 1.1 },
+  reference: { kind: 'geometric', label: '0-5 deg', min: 0, max: 5, status: 'draft' },
+};
+const reply = (content: string, ok = true) =>
+  (async () => ({ ok, status: ok ? 200 : 503, json: async () => ({ choices: [{ message: { content } }] }) })) as unknown as typeof fetch;
+const provider = (f: typeof fetch) => createOpenRouterPostureProvider({ apiKey: 'sk-or-test-key', model: 'm/x', fetchImpl: f });
+
+describe('openrouter posture narrator', () => {
+  it('accepts a faithful sentence and keeps the structured fields from the verdict', async () => {
+    const f = reply(JSON.stringify({ text: 'Shoulder-line tilt: 9.3° ± 1.1°; above the 0-5 deg reference by about 4.3°.' }));
+    const r = await explainPostureRow(verdict, { provider: provider(f) });
+    expect(r.status).toBe('llm');
+    expect(r.source).toBe('openrouter:m/x');
+  });
+  it('escalates when the model invents a number', async () => {
+    const f = reply(JSON.stringify({ text: 'Shoulder-line tilt: 9.3° ± 1.1°; above the 0-5 deg reference, about 20° off.' }));
+    const r = await explainPostureRow(verdict, { provider: provider(f), maxAttempts: 2 });
+    expect(r.status).toBe('escalated');
+    expect(r.text).toBeNull();
+  });
+  it('escalates when the model uses causal or grading words', async () => {
+    const f = reply(JSON.stringify({ text: 'Shoulder-line tilt: 9.3° ± 1.1°; above the 0-5 deg reference due to desk work.' }));
+    expect((await explainPostureRow(verdict, { provider: provider(f), maxAttempts: 1 })).status).toBe('escalated');
+  });
+  it('falls back to the template when the API errors or returns junk', async () => {
+    expect((await explainPostureRow(verdict, { provider: provider(reply('', false)) })).status).toBe('template_fallback');
+    expect((await explainPostureRow(verdict, { provider: provider(reply('not json at all')) })).status).toBe('template_fallback');
+  });
+  it('never puts the key in an error or audit trail', async () => {
+    const r = await explainPostureRow(verdict, { provider: provider(reply('', false)) });
+    expect(JSON.stringify(r)).not.toContain('sk-or-test-key');
+  });
+});
+
+import { postureProviderFromEnv, DEFAULT_POSTURE_MODEL } from './posture-llm';
+
+describe('postureProviderFromEnv', () => {
+  it('returns undefined (deterministic template only) when no key is configured', () => {
+    expect(postureProviderFromEnv({})).toBeUndefined();
+    expect(postureProviderFromEnv({ OPENROUTER_API_KEY: '   ' })).toBeUndefined();
+  });
+  it('uses the benchmarked default model', () => {
+    const p = postureProviderFromEnv({ OPENROUTER_API_KEY: 'k' });
+    expect(DEFAULT_POSTURE_MODEL).toBe('mistralai/mistral-small-3.2-24b-instruct');
+    expect(p?.name).toBe(`openrouter:${DEFAULT_POSTURE_MODEL}`);
+  });
+  it('prefers POSTURE_LLM_API_KEY and honours POSTURE_LLM_MODEL', () => {
+    const p = postureProviderFromEnv({ POSTURE_LLM_API_KEY: 'a', OPENROUTER_API_KEY: 'b', POSTURE_LLM_MODEL: 'x/y' });
+    expect(p?.name).toBe('openrouter:x/y');
+  });
+  it('can be switched off even when a key is present', () => {
+    expect(postureProviderFromEnv({ OPENROUTER_API_KEY: 'k', POSTURE_LLM_DISABLED: '1' })).toBeUndefined();
+  });
+});
