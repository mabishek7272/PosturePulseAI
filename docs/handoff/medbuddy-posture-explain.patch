+/**
+ * Benchmarks candidate OpenRouter models as the posture-sentence narrator, through the
+ * real consistency guard. Usage: OPENROUTER_API_KEY=... tsx scripts/posture-model-bench.ts [model ...]
+ * Rows are synthetic; no patient data is ever sent. The key is read from the environment only.
+ */
+import { buildPosturePrompt } from '../src/cds/posture-explanation/prompt';
+import { checkPostureConsistency } from '../src/cds/posture-explanation/consistency-guard';
+import { computePosition } from '../src/cds/posture-explanation/format';
+import type { PostureVerdict } from '../src/cds/posture-explanation/types';
+import { createOpenRouterPostureProvider } from '../src/api/posture-llm';
+
+const KEY = process.env.OPENROUTER_API_KEY;
+if (!KEY) { console.error('OPENROUTER_API_KEY not set'); process.exit(1); }
+
+const MODELS = process.argv.slice(2).length ? process.argv.slice(2) : [
+  'openai/gpt-oss-120b', 'openai/gpt-oss-20b', 'mistralai/mistral-small-3.2-24b-instruct',
+  'deepseek/deepseek-v4-flash', 'qwen/qwen3.7-flash', 'google/gemma-3-12b-it', 'meta-llama/llama-3.1-8b-instruct',
+];
+const RUNS = Number(process.env.RUNS ?? 2);
+
+const ref = (label: string, min: number, max: number) => ({ kind: 'geometric' as const, label, min, max, status: 'draft' as const });
+function row(i: number, o: Partial<PostureVerdict> & { v?: number; u?: number; r?: ReturnType<typeof ref> | null }): PostureVerdict {
+  const estimate = o.estimate === undefined ? { value: o.v ?? 1, uncertainty: o.u ?? 1 } : o.estimate;
+  const reference = o.r === undefined ? (o.reference ?? ref('0 deg', 0, 0)) : o.r;
+  const v: PostureVerdict = { rowId: `r${i}`, metricKey: 'static.x', label: 'Shoulder-line tilt', tier: 'proxy', unit: 'deg', side: null,
+    position: 'within', estimate, reference, ...o } as PostureVerdict;
+  delete (v as any).v; delete (v as any).u; delete (v as any).r;
+  v.estimate = estimate; v.reference = reference;
+  v.position = computePosition(estimate, reference);
+  return v;
+}
+const ROWS: PostureVerdict[] = [
+  row(1, { v: 1.2, u: 0.6, r: ref('0-5 deg', 0, 5) }),
+  row(2, { v: 9.3, u: 1.1, r: ref('0-5 deg', 0, 5) }),
+  row(3, { v: -4.4, u: 0.5, r: ref('0-5 deg', 0, 5), label: 'Hip-line tilt' }),
+  row(4, { v: 5.2, u: 1.5, r: ref('0-5 deg', 0, 5), label: 'Knee extension', side: 'left', tier: 'estimate' }),
+  row(5, { v: 3.1, u: 0.8, r: null, label: 'Head-shoulder angle' }),
+  row(6, { v: 2.6, u: 1.5, r: ref('0 deg', 0, 0), label: 'Trunk lateral lean', tier: 'estimate' }),
+  row(7, { v: 6.8, u: 0.9, r: ref('0 percent_stature', 0, 0), label: 'Lateral body shift', unit: 'percent_stature', tier: 'estimate' }),
+  row(8, { estimate: null, r: ref('0 deg', 0, 0), label: 'Hip-line tilt', unsupportedReasons: ['out_of_frame'] }),
+  row(9, { v: 0.3, u: 0.2, r: ref('0-5 deg', 0, 5), label: 'Knee frontal alignment', side: 'right' }),
+  row(10, { v: 12.4, u: 2.0, r: ref('0-10 cm', 0, 10), label: 'Plumb offset at ear', unit: 'cm', tier: 'estimate' }),
+];
+
+let catalog: any[] = [];
+const price = (id: string) => { const m = catalog.find((x) => x.id === id); return m ? [Number(m.pricing.prompt) * 1e6, Number(m.pricing.completion) * 1e6] : [NaN, NaN]; };
+
+async function ask(model: string, v: PostureVerdict) {
+  const provider = createOpenRouterPostureProvider({ apiKey: KEY as string, model, timeoutMs: 40000 });
+  const t0 = Date.now();
+  try {
+    const draft = await provider.generate({ prompt: buildPosturePrompt(v), verdict: v, attempt: 1 });
+    const c = checkPostureConsistency(v, draft);
+    return { ok: c.consistent, err: c.consistent ? '' : c.violations[0], ms: Date.now() - t0, pt: 0, ct: 0, text: draft.text };
+  } catch (e) {
+    return { ok: false, err: String(e instanceof Error ? e.message : e).slice(0, 80), ms: Date.now() - t0, pt: 0, ct: 0 };
+  }
+}
+
+async function main() {
+  catalog = (await (await fetch('https://openrouter.ai/api/v1/models')).json() as any).data;
+  console.log(`rows=${ROWS.length} runs=${RUNS}`);
+  for (const model of MODELS) {
+    let pass = 0, total = 0, ms = 0, pt = 0, ct = 0; const fails: string[] = []; let sample = '';
+    for (let r = 0; r < RUNS; r++) for (const v of ROWS) {
+      const out = await ask(model, v).catch((e) => ({ ok: false, err: String(e), ms: 0, pt: 0, ct: 0 } as any));
+      total++; ms += out.ms; pt += out.pt; ct += out.ct;
+      if (out.ok) { pass++; sample ||= (out as any).text; } else fails.push(`${v.rowId}:${out.err}`);
+    }
+    const [pi, po] = price(model);
+    const per1k = ((300 * pi + 60 * po) / 1e6) * 1000; // ~300 prompt + ~60 completion tokens per row
+    console.log(`${model.padEnd(42)} pass ${String(pass).padStart(2)}/${total}  avg ${Math.round(ms / total)}ms  ~$${per1k.toFixed(4)} per 1000 rows`);
+    if (fails.length) console.log(`   fails: ${[...new Set(fails)].slice(0, 4).join(' | ')}`);
+    if (sample) console.log(`   e.g. ${sample}`);
+  }
+
+}
+main().catch((e) => { console.error(String(e).replace(/sk-[A-Za-z0-9_-]+/g, '<redacted>')); process.exit(1); });
