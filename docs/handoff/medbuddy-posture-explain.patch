+/**
+ * Posture-report explanation layer types.
+ *
+ * Same authority model as src/cds/explanation: a deterministic caller (the
+ * beAIve report builder) has already measured and classified each row. This layer only
+ * DESCRIBES a row in one sentence and can never change a number or a position. Every
+ * narrative - template or injected model - must pass the consistency guard.
+ *
+ * The request carries no patient or session identifiers by design (validate.ts
+ * rejects unknown fields).
+ */
+
+export type PosturePosition =
+  | 'below' | 'within' | 'above' | 'indeterminate' | 'no_reference' | 'not_applicable';
+export type PostureTier = 'estimate' | 'proxy' | 'entered' | 'annotated';
+export type PostureUnit = 'deg' | 'cm' | 'percent_stature' | 's' | 'count' | 'per_min' | 'percent' | 'none';
+export type PostureSide = 'left' | 'right' | 'bilateral' | null;
+
+export interface PostureVerdict {
+  /** Caller's row id, echoed back. Not an identifier of a person. */
+  rowId: string;
+  metricKey: string;
+  /** Descriptive name supplied by the caller. Checked against the banned-phrase list. */
+  label: string;
+  tier: PostureTier;
+  unit: PostureUnit;
+  side: PostureSide;
+  position: PosturePosition;
+  estimate?: { value: number; uncertainty: number } | null;
+  reference?: {
+    kind: 'geometric' | 'literature';
+    /** Human label, e.g. "0-5 deg". */
+    label: string;
+    min: number;
+    max: number;
+    status: 'draft' | 'approved';
+  } | null;
+  /** Plain reason codes (quality-gate vocabulary) when the row could not be measured. */
+  unsupportedReasons?: string[];
+}
+
+export interface PostureAssertions {
+  rowId: string;
+  metricKey: string;
+  position: PosturePosition;
+  side: PostureSide;
+  /** Value rounded to 0.1, absent when the row has no estimate. */
+  value?: number;
+  /** Distance of the estimate from the nearest reference bound (0.1), only for above/below. */
+  deviation?: number;
+}
+
+export interface PostureDraft {
+  text: string;
+  assertions: PostureAssertions;
+}
+
+export interface PostureProviderInput {
+  prompt: string;
+  verdict: PostureVerdict;
+  attempt: number;
+}
+
+export interface PostureProvider {
+  name: string;
+  generate(input: PostureProviderInput): PostureDraft | Promise<PostureDraft>;
+}
+
+export interface PostureConsistency {
+  consistent: boolean;
+  violations: string[];
+}
+
+export type PostureExplanationStatus = 'template' | 'llm' | 'template_fallback' | 'escalated';
+
+export interface PostureExplanation {
+  rowId: string;
+  status: PostureExplanationStatus;
+  /** null when escalated: the caller must use its own fixed sentence. */
+  text: string | null;
+  assertions: PostureAssertions | null;
+  source: string;
+  attempts: number;
+  escalate: boolean;
+  flagged: boolean;
+  consistency: PostureConsistency;
+  audit: Array<{ type: string; attempt: number; detail?: string }>;
+}
+
+export const EXPLANATION_VERSION = 'posture-explain/v0';
