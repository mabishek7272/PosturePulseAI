Pod::Spec.new do |s|
  s.name           = 'ARJig'
  s.version        = '1.0.0'
  s.summary        = 'ARKit + LiDAR spatial-gate capture for PosturePulse assessments'
  s.description    = 'Places a metric 60x40cm floor template with ARKit scene reconstruction, ' \
                     'gates recording on camera level/height/distance/foreground clearance, and ' \
                     'records a clip plus per-frame gravity in the clip-capture.schema.json camera frame.'
  s.author         = 'beAIve'
  s.homepage       = 'https://docs.expo.dev/modules/'
  # iOS only: ARKit and RealityKit are not available on tvOS.
  s.platforms      = {
    :ios => '16.4'
  }
  s.source         = { git: '' }
  s.static_framework = true

  s.dependency 'ExpoModulesCore'

  s.frameworks = 'ARKit', 'RealityKit', 'AVFoundation', 'CoreVideo'

  # Swift/Objective-C compatibility
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
  }

  # Tests/ is EXCLUDED from the pod and is built by SwiftPM instead
  # (../Package.swift, `swift test --package-path apps/mobile/modules/ar-jig`).
  #
  # A CocoaPods `test_spec` was tried here first and does NOT work: CocoaPods
  # only installs test specs when the Podfile opts in per-pod with
  # `:testspecs => ['Tests']`, the Podfile is generated by Expo prebuild, and
  # `apps/mobile/.gitignore` ignores `/ios` - so there is nowhere to put that
  # opt-in that survives a clean build. Declaring a test_spec that never
  # materialises is worse than not declaring one, because it reads like
  # coverage that exists.
  #
  # The exclusion itself is load-bearing regardless: without it the glob sweeps
  # the XCTest file into the shipped module, which fails to link in a release
  # build because XCTest is not in the app.
  s.source_files   = "**/*.{h,m,mm,swift,hpp,cpp}"
  s.exclude_files  = "Tests/**/*"
end
