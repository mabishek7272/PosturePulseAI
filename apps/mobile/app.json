{
  "expo": {
    "name": "PosturePulse AI",
    "slug": "posturepulse-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "posturepulse",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beaive.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "PosturePulse AI needs the camera to record the assessment poses.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.beaive.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eef0fb",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "822a48dc-e755-45c7-94cb-0c9c65bff511"
      }
    },
    "owner": "airivuinnovationmachina",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/822a48dc-e755-45c7-94cb-0c9c65bff511"
    }
  }
}
